{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EAiCoding",
  "version": "0.1.4",
  "identifier": "com.eaicoding.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:installer && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EAiCoding",
        "width": 600,
        "height": 700,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/eagent-tools": "eagent-tools",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../third_party/7zip": "licenses/7zip"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "installer/installer.nsi",
        "installerHooks": "installer/ui.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
