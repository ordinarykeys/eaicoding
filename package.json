{
  "name": "eaicoding-desktop",
  "private": true,
  "version": "0.1.10",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-ort.mjs",
    "predev": "node scripts/prepare-ort.mjs && node scripts/prepare-model-runtime.mjs",
    "prebuild": "node scripts/prepare-ort.mjs && node scripts/prepare-model-runtime.mjs",
    "prepare:models": "node scripts/prepare-model-runtime.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:jingyi-docs": "node scripts/build-jingyi-docs.mjs",
    "build:jingyi-vector": "node scripts/build-jingyi-vector-index.mjs",
    "test:agent-choice": "node scripts/test-agent-choice.mjs",
    "test:agent-epl": "node scripts/test-epl-diagnostics.mjs",
    "test:agent-retrieval": "node scripts/test-agent-retrieval.mjs",
    "test:agent-runtime": "node scripts/test-agent-runtime.mjs",
    "test:code-highlight": "node scripts/test-code-highlight.mjs",
    "test:code-work": "node scripts/test-code-work.mjs",
    "test:ui": "node scripts/test-ui-smoke.mjs",
    "test:native-gui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-gui.ps1",
    "test:native-menu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-menu.ps1",
    "benchmark:agent": "node scripts/benchmark-agent.mjs",
    "promptfoo:agent": "npx promptfoo@latest eval -c promptfoo.agent.yaml",
    "preview": "vite preview",
    "tauri": "tauri",
    "package:portable": "node scripts/package-portable.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:module-parser": "node scripts/test-module-parser.mjs",
    "test:native-workbench": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-workbench.ps1",
    "prepare:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-installer.ps1",
    "test:model-providers": "node scripts/test-model-providers.mjs",
    "test:model-auth": "node scripts/test-model-auth.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@huggingface/transformers": "^4.2.0",
    "@phosphor-icons/react": "^2.1.9",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tauri-apps/api": "~2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.3",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "8.0.2",
    "i18next": "^26.0.8",
    "idb-keyval": "^6.2.2",
    "nanoid": "^5.0.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.0.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@types/big.js": "^7.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "7zip-bin": "5.2.0",
    "archiver": "^7.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
